# Local Postgres connection string. Copy this file to .env and fill in your own.
# Local example (after `createdb civil_portal`):
DATABASE_URL=postgresql://localhost:5432/civil_portal

# Render will inject its own DATABASE_URL automatically once you attach a
# managed Postgres database to this service — you don't set this in Render's
# dashboard yourself, it appears under the service's Environment tab.

PORT=3000
